    },
    {
      "id": "invisible",
      "file": "src/invisible.mjs"
    },
    {
      "id": "output",
      "file": "src/output.mjs"
    },
    {
      "id": "joining-type",
      "file": "src/joining-type.mjs"
    },
    {
      "id": "rehydrate",
      "file": "src/rehydrate.mjs"
    },
    {
      "id": "instructions",
      "file": "src/instructions.mjs"
    },
    {
      "id": "view-map",
      "file": "src/view-map.mjs"
    },
    {
      "id": "hook-io",
      "file": "claude-hooks/lib/hook-io.mjs"
    },
    {
      "id": "hook-sanitize-output",
      "file": "claude-hooks/sanitize-output.mjs"
    },
    {
      "id": "hook-redactor-client",
      "file": "claude-hooks/lib/redactor-client.mjs"
    },
    {
      "id": "hook-pretooluse",
      "file": "claude-hooks/pretooluse-sanitize.mjs"
