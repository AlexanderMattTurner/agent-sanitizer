# Portable-symlink check: rejects a tracked symlink with an absolute target
# before it can reach the remote. Runs the SAME script CI does (no
# reimplementation, so they can't drift); git-only, milliseconds.
symlinks="$git_root/.github/scripts/check-symlinks.sh"
if [[ -f "$symlinks" ]]; then
  bash "$symlinks"
fi
