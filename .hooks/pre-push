#!/bin/bash
# Pre-push hook: run the pre-commit suite over the commits being pushed, plus
# the portable-symlink check, so they abort the push instead of surfacing as a
# red check on the PR.
#
# The per-commit hook formats staged files; this catches everything the push
# would introduce (e.g. an edit committed with --no-verify, or files brought in
# by a merge) before it can reach the remote. The check is scoped to the pushed
# range — `pre-commit run --from-ref <remote> --to-ref <local>` — so a push
# costs seconds, not a minutes-long whole-tree sweep. pre-commit.yaml re-runs
# the full suite on the PR in CI, so it catches web-editor edits that bypass
# this hook. A failure aborts the push: commit the fixes pre-commit applied (or
# fix the real lint error it reports) and push again.

set -euo pipefail

git_root=$(git rev-parse --show-toplevel)
# shellcheck source=.hooks/lib-gate.sh
source "$git_root/.hooks/lib-gate.sh"

# Git hooks run in a bare shell and don't inherit session PATH edits; surface
# the venv's tools plus uv/uvx and cargo installs.
if [[ -d "$git_root/.venv/bin" ]]; then
  export PATH="$git_root/.venv/bin:$PATH"
fi
export PATH="$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

