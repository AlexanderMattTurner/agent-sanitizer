{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  // Dependabot stays enabled for SECURITY updates only (see .github/dependabot.yml).
  // Renovate's job here is narrower: keep the plugin's pinned engine and its
  // build/runtime peers current, since the committed bundle is only rebuilt when
  // one of these moves.
  // npm ONLY. The `pip_requirements` manager's default file match covers
  // `requirements.txt` but not `requirements.in`, so with the Python tree locked
  // it would edit plugin/requirements.txt — rewriting the `==` pin in place
  // WITHOUT regenerating the `--hash=` lines beside it, producing a lock whose
  // hashes belong to the old version. `build-redactor-pyz.mjs` then fails hash
  // verification, and `lock-redactor-deps.mjs --if-stale` sees the engine
  // version already matching and skips the re-lock that would repair it. The
  // engine bump is driven by the npm alias alone: build-plugin.mjs regenerates
  // requirements.in from it and --if-stale re-locks from there, hashes included.
  enabledManagers: ["npm"],
  schedule: ["* 0-6 * * *"],
  rangeStrategy: "pin",
  // Default off, then opt each watched pin in below — a blanket enable would
  // open PRs for the whole dev toolchain, none of which affects the artifact.
  packageRules: [
    {
      matchPackageNames: ["*"],
      enabled: false,
    },
    {
      // The npm alias is the ONE place the engine pin lives; the PyPI half is
      // derived from it (build-plugin.mjs writes plugin/requirements.in, then
      // lock-redactor-deps.mjs compiles the hashed lock). Both spellings are
      // matched because an npm alias reports depName `sanitizer-engine` and
      // packageName `agent-sanitizer`, and which one a rule sees has changed
      // across Renovate versions.
      groupName: "sanitizer-engine",
      matchPackageNames: ["agent-sanitizer", "sanitizer-engine"],
      enabled: true,
      automerge: true,
    },
    {
      // Inlined into the bundle, so a bump changes the committed artifact.
      groupName: "plugin runtime peers",
      matchPackageNames: ["agent-control-plane-core", "namespace-guard"],
      enabled: true,
      automerge: true,
    },
    {
      // The bundler itself: its output bytes are part of the reproducibility
      // contract, so a version bump must go through the same regenerate-and-verify
      // path as an engine bump.
      matchPackageNames: ["esbuild"],
      enabled: true,
      automerge: true,
    },
  ],
  // Automerge only once the required checks are green — the plugin-dist-autofix
  // workflow pushes the regenerated bundle onto the bump PR first, and the
  // reproducibility test is what proves it landed.
  platformAutomerge: true,
}
