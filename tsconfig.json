{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.mjs",
    "bin/**/*.mjs",
    "scripts/shipped-sources.mjs",
    "scripts/coverage.mjs",
    "scripts/mutate.mjs"
  ]
}
