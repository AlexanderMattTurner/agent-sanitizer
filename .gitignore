# Claude Code worktree scaffolding
.worktrees/
.claude/worktrees/

# Dependencies
node_modules
.pnpm-store/

# Build outputs
dist/
build/
out/
types/

# The Claude Code plugin's build outputs, beside plugin/dist/ (already covered by
# `dist/` above). `pnpm build:plugin` writes them; the release bakes them onto
# the `plugin-dist` branch the marketplace installs from, so no other branch
# carries them (plugin/scripts/baked-artifacts.mjs lists the full set).
plugin/requirements.in
plugin/scripts/lib/fail-open.sh
plugin/scripts/lib/node-floor.sh

# Environment files
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# Claude Code local settings (written by SessionStart hook in web sessions)
.claude/settings.local.json

# Claude Code personal notes (recurring nitpicks / review feedback, never committed)
CLAUDE.local.md
.claude/CLAUDE.local.md

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage
coverage/

# Python
__pycache__/
*.pyc
.venv/
.uv/
*.egg-info/

# Generated: the self-contained CLI bundled into the Python wheel at build time
# (see scripts/bundle-python-cli.mjs). A build artifact from src/, never committed.
python/agent_sanitizer/_bundled/

# Stryker mutation testing
.stryker-tmp/
reports/mutation/
reports/stryker-incremental.json
stryker.shard.json
stryker.dryrun.json

# gh CLI state, written when a tool run puts HOME inside the checkout.
.local/

# `pnpm pack` output: a build artifact regenerated on demand, never a source.
*.tgz

# Generated at install, pack and build time by scripts/gen-unicode.mjs (`pnpm
# install` runs it through `prepare`, `npm pack` through `prepack`) from the
# UCD package pnpm-lock.yaml pins. Build output is never tracked: the reviewable
# surface is the generators plus the lockfile. The wheel's hatch `artifacts`
# force-includes the JSON, so generate before every `uv build`.
src/cf-charset.mjs
src/joining-type.mjs
src/standardized-variants.mjs
src/unicode-properties.mjs
python/agent_sanitizer/data/invisible-charset.json
