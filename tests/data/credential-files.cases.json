{
  "_comment": "CONFORMANCE CORPUS for the credential-FILE path matcher, shared by both language suites. The vocabulary in credential-files.json is single-sourced, but the RULE built from it is two hand-written twins (src/credential-files.mjs and agent_sanitizer/secrets/credential_files.py) because an npm consumer cannot import Python and a wheel cannot import JavaScript. test/credential-files.test.mjs and tests/secrets/test_credential_files.py each assert their own matcher against the SAME literal verdicts, so a divergence reds in whichever language broke. Every `expected` is hand-written, never computed from either implementation. `globExamples` gives one real path per vocabulary entry, and each language asserts that entry alone matches it. It lives under tests/data/, not beside the vocabulary, so the wheel does not ship it.",
  "globExamples": {
    "nameGlobs": {
      ".env": "/home/u/project/.env",
      ".env.*": "/home/u/project/.env.production",
      "*.env": "/home/u/project/prod.env",
      ".envrc": "/home/u/project/.envrc",
      ".npmrc": "/home/u/.npmrc",
      ".netrc": "/home/u/.netrc",
      "_netrc": "/home/u/_netrc",
      ".pypirc": "/home/u/.pypirc",
      ".pgpass": "~/.pgpass",
      ".dockercfg": "/home/u/.dockercfg",
      ".boto": "/home/u/.boto",
      ".htpasswd": "/srv/site/.htpasswd",
      ".s3cfg": "~/.s3cfg",
      ".rclone.conf": "/home/u/.rclone.conf",
      ".git-credentials": "/home/u/.git-credentials",
      "authorized_keys": "/srv/keys/authorized_keys",
      "id_rsa": "/srv/keys/id_rsa",
      "id_dsa": "/srv/keys/id_dsa",
      "id_ecdsa": "/srv/keys/id_ecdsa",
      "id_ed25519": "/srv/keys/id_ed25519",
      "*secret*": "/home/u/project/client_secret.txt",
      "*credential*": "/home/u/project/credentials.csv",
      "*service-account*.json": "/home/u/project/my-service-account-prod.json",
      "*service_account*.json": "/home/u/project/service_account_key.json",
      "*serviceaccount*.json": "/home/u/project/serviceaccount.json",
      "*.tfvars": "/home/u/infra/prod.tfvars",
      "*.tfvars.json": "/home/u/infra/prod.tfvars.json",
      "*.pem": "/etc/ssl/server.pem",
      "*.p12": "/home/u/cert.p12",
      "*.pfx": "/home/u/cert.pfx",
      "*.key": "/etc/ssl/server.key"
    },
    "pathGlobs": {
      "*/.docker/config.json": "/home/u/.docker/config.json",
      "*/.kube/config": "/home/u/.kube/config",
      "*/.config/gh/hosts.yml": "/home/u/.config/gh/hosts.yml",
      "*/.aws/credentials": "/home/u/.aws/credentials",
      "*/.aws/config": "/home/u/.aws/config",
      "*/.config/gcloud/*credentials*": "/home/u/.config/gcloud/application_default_credentials.json",
      "*/.azure/*token*": "/home/u/.azure/msal_token_cache.json"
    },
    "directories": {
      ".ssh": "/home/u/.ssh/known_hosts",
      ".gnupg": "/home/u/.gnupg/pubring.kbx",
      ".aws": "/home/u/.aws/sso/cache/x.json",
      ".kube": "/home/u/.kube/cache/x"
    }
  },
  "cases": [
    {
      "id": "tilde-pgpass",
      "path": "~/.pgpass",
      "expected": true,
      "why": "the .pgpass file the two old lists both missed"
    },
    {
      "id": "docker-config",
      "path": "/home/u/.docker/config.json",
      "expected": true,
      "why": "registry auth lives in the tool directory's config.json"
    },
    {
      "id": "gh-hosts",
      "path": "/home/u/.config/gh/hosts.yml",
      "expected": true,
      "why": "the GitHub CLI token file"
    },
    {
      "id": "ssh-known-hosts",
      "path": "/home/u/.ssh/known_hosts",
      "expected": true,
      "why": "anything under .ssh counts, not only the key names"
    },
    {
      "id": "tilde-s3cfg",
      "path": "~/.s3cfg",
      "expected": true,
      "why": "the s3cmd credential file"
    },
    {
      "id": "upper-env",
      "path": "/HOME/U/.ENV",
      "expected": true,
      "why": "the leaf name match folds case"
    },
    {
      "id": "mixed-docker",
      "path": "/home/u/.Docker/Config.JSON",
      "expected": true,
      "why": "the path match folds case"
    },
    {
      "id": "upper-ssh-dir",
      "path": "/home/u/.SSH/known_hosts",
      "expected": true,
      "why": "the directory match folds case"
    },
    {
      "id": "upper-pem",
      "path": "/etc/ssl/SERVER.PEM",
      "expected": true,
      "why": "a name glob matches an upper-case extension"
    },
    {
      "id": "relative-docker",
      "path": ".docker/config.json",
      "expected": true,
      "why": "a relative path meets a */ path glob"
    },
    {
      "id": "relative-nested-kube",
      "path": "project/.kube/config",
      "expected": true,
      "why": "a relative path nested in a project meets a path glob"
    },
    {
      "id": "relative-gh",
      "path": ".config/gh/hosts.yml",
      "expected": true,
      "why": "a relative path meets a */ path glob"
    },
    {
      "id": "relative-dot-prefix",
      "path": "./.pgpass",
      "expected": true,
      "why": "a leading ./ is ignored"
    },
    {
      "id": "trailing-slash",
      "path": "/home/u/.ssh/",
      "expected": true,
      "why": "a trailing slash leaves the directory component"
    },
    {
      "id": "bare-directory",
      "path": ".ssh",
      "expected": true,
      "why": "a bare directory name is a credential directory"
    },
    {
      "id": "doubled-separators",
      "path": "/home/u//.docker//config.json",
      "expected": true,
      "why": "empty components are ignored"
    },
    {
      "id": "star-crosses-separator",
      "path": "/home/u/.config/gcloud/legacy_credentials/a@b.com/adc.json",
      "expected": true,
      "why": "a star in a path glob crosses a separator"
    },
    {
      "id": "deep-azure",
      "path": "/home/u/.azure/cache/accessTokens.json",
      "expected": true,
      "why": "a star in a path glob crosses a separator"
    },
    {
      "id": "bare-secret-word",
      "path": "/home/u/secret",
      "expected": true,
      "why": "a trailing star matches the empty string"
    },
    {
      "id": "secret-in-source-name",
      "path": "/home/u/project/secrets.py",
      "expected": true,
      "why": "*secret* is name-shaped: a known false positive the data documents"
    },
    {
      "id": "env-dot-suffix",
      "path": "/home/u/project/.env.local",
      "expected": true,
      "why": ".env.* covers a suffixed env file"
    },
    {
      "id": "private-key-no-ext",
      "path": "/home/u/keys/id_ed25519",
      "expected": true,
      "why": "a private key name matches without a directory"
    },
    {
      "id": "project-config",
      "path": "/home/u/project/config.json",
      "expected": false,
      "why": "config.json is a credential file only under .docker"
    },
    {
      "id": "readme",
      "path": "README.md",
      "expected": false,
      "why": "an ordinary doc"
    },
    {
      "id": "tokenizer",
      "path": "tokenizer.py",
      "expected": false,
      "why": "token alone is not a credential file name"
    },
    {
      "id": "public-key",
      "path": "/home/u/project/id_rsa.pub",
      "expected": false,
      "why": "a public key is not secret"
    },
    {
      "id": "docker-lookalike",
      "path": "/home/u/docker/config.json",
      "expected": false,
      "why": "the tool directory must start with a dot"
    },
    {
      "id": "gh-other-file",
      "path": "/home/u/.config/gh/other.yml",
      "expected": false,
      "why": "only hosts.yml holds the token"
    },
    {
      "id": "gh-lookalike-dir",
      "path": "/home/u/.config/ghx/hosts.yml",
      "expected": false,
      "why": "the directory name must match whole"
    },
    {
      "id": "sshd-lookalike",
      "path": "/home/u/.sshd/config",
      "expected": false,
      "why": "a directory name matches whole"
    },
    {
      "id": "envoy",
      "path": "/home/u/project/.envoy",
      "expected": false,
      "why": ".env.* needs the dot after env"
    },
    {
      "id": "environment",
      "path": "/home/u/project/environment.py",
      "expected": false,
      "why": "env inside a longer name is not an env file"
    },
    {
      "id": "keynote",
      "path": "/home/u/talks/slides.keynote",
      "expected": false,
      "why": "*.key needs the extension to end the name"
    },
    {
      "id": "empty",
      "path": "",
      "expected": false,
      "why": "an empty path names nothing"
    },
    {
      "id": "root",
      "path": "/",
      "expected": false,
      "why": "the root names nothing"
    },
    {
      "id": "dot-only",
      "path": ".",
      "expected": false,
      "why": "the current directory names nothing"
    },
    {
      "id": "parent-traversal",
      "path": "../project/main.py",
      "expected": false,
      "why": "a parent component is not a credential directory"
    }
  ]
}
