{
  "_comment": "Shared conformance data for the credential-file matcher; both language suites assert these hand-written verdicts. cases: [path, expected, why]. emptySpecs: [field, value] each making that field empty or missing (null means the key is absent). badEntries: per field, entries the validator must refuse.",
  "inert": {
    "nameGlobs": ["inert.placeholder"],
    "pathGlobs": ["*/inert/placeholder"],
    "directories": ["inert-dir"]
  },
  "cases": [
    ["~/.pgpass", true, "the .pgpass file the two old lists both missed"],
    ["/home/u/.docker/config.json", true, "the registry auth file"],
    ["/home/u/.config/gh/hosts.yml", true, "the GitHub CLI token file"],
    ["/home/u/.ssh/known_hosts", true, "all of .ssh counts"],
    ["~/.s3cfg", true, "the s3cmd credential file"],
    ["/HOME/U/.ENV", true, "the leaf name match folds case"],
    ["/home/u/.Docker/Config.JSON", true, "the path match folds case"],
    ["/home/u/.SSH/known_hosts", true, "the directory match folds case"],
    ["/etc/ssl/SERVER.PEM", true, "an upper-case extension"],
    [".docker/config.json", true, "a relative path meets a */ path glob"],
    ["project/.kube/config", true, "relative, nested path"],
    ["./.pgpass", true, "a leading ./ is ignored"],
    ["/home/u/.ssh/", true, "a trailing slash leaves the directory component"],
    [".ssh", true, "a bare directory name is a credential directory"],
    ["/home/u//.docker//config.json", true, "empty components are ignored"],
    ["/h/.config/gcloud/legacy_credentials/a/b.json", true, "star crosses /"],
    ["/home/u/.azure/cache/accessTokens.json", true, "star crosses /"],
    ["/home/u/secret", true, "a trailing star matches the empty string"],
    ["/home/u/project/secrets.py", true, "known false positive"],
    ["/home/u/project/.env.local", true, ".env.* covers a suffixed env file"],
    ["/home/u/keys/id_ed25519", true, "a key name alone"],
    ["/home/u/project/config.json", false, "only under .docker"],
    ["/home/u/.npmrc/readme.txt", false, "the leaf, not a directory"],
    ["README.md", false, "an ordinary doc"],
    ["tokenizer.py", false, "token alone is not a credential file name"],
    ["/home/u/project/id_rsa.pub", false, "a public key is not secret"],
    ["/home/u/docker/config.json", false, "the dot is required"],
    ["/home/u/.config/gh/other.yml", false, "only hosts.yml holds the token"],
    ["/home/u/.config/ghx/hosts.yml", false, "whole name only"],
    ["/home/u/.sshd/config", false, "a directory name matches whole"],
    ["/home/u/project/.envoy", false, ".env.* needs the dot after env"],
    ["/home/u/project/environment.py", false, "env inside a longer name"],
    ["/home/u/talks/slides.keynote", false, "the extension ends the name"],
    ["", false, "an empty path names nothing"],
    ["/", false, "the root names nothing"],
    [".", false, "the current directory names nothing"],
    ["../project/main.py", false, "no credential directory"],
    ["/home/u/.config/gh/../gh/hosts.yml", true, ".. collapses first"],
    ["/home/u/.config/gh/../ghx/hosts.yml", false, "collapses to ghx, not gh"],
    ["/home/u/\u017fecret", false, "long s stays; JS cannot fold"],
    ["/home/u/x.\u212aey", true, "Kelvin sign lowers to k"]
  ],
  "emptySpecs": [
    ["nameGlobs", null],
    ["nameGlobs", []],
    ["nameGlobs", "env"],
    ["pathGlobs", []],
    ["directories", []]
  ],
  "badEntries": {
    "nameGlobs": [7, "*", "**", ".ENV", "a/b", "a[bc]", "a?", "env\n", ""],
    "pathGlobs": [".docker/config.json", "*/*"],
    "directories": ["*", "a/b", "..", "."]
  }
}
